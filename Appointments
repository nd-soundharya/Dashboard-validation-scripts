-- Completed appointments
select count(distinct appointmentid) from reporting_tng.PROVIDER_UTILIZATION
WHERE 1=1
And APPOINTMENTSTATUS IN ('4 - Charge Entered','3 - Checked Out','2 - Checked In') OR APPOINTMENTSTATUS = 'f - Filled' 
AND PATIENTID IS NOT NULL
  AND APPOINTMENTID IS NOT NULL
  AND COALESCE(APPOINTMENTCANCELREASON,'') <> 'SCHEDULING ERROR'
  AND PATIENTID NOT IN (SELECT patient_id FROM reporting_tng.REGISTRATION WHERE last_name = 'TESTPATIENT');
  
  -- cancelled appointments
select count(appointmentid) from reporting_tng.PROVIDER_UTILIZATION
-- select * from reporting_tng.PROVIDER_UTILIZATION
WHERE APPOINTMENTSTATUS = 'x - Cancelled'  AND 
APPOINTMENTCANCELREASON NOT IN ('PATIENT NO SHOW','PATIENT CANCELLED LESS THAN 24 HOURS','ENCOUNTER DELETED PT NOT SEEN - Telemed') 
AND COALESCE(FROZENYN,'N') != 'Y'
AND PATIENTID IS NOT NULL
  AND APPOINTMENTID IS NOT NULL
  AND COALESCE(APPOINTMENTCANCELREASON,'') <> 'SCHEDULING ERROR'
  AND PATIENTID NOT IN (SELECT patient_id FROM reporting_tng.REGISTRATION WHERE last_name = 'TESTPATIENT');

