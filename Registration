-- DAILY AVERAGE
WITH daily AS (
    SELECT
        CAST(registration_date AS DATE) AS reg_day,
        COUNT(patient_id) AS daily_registrations
    FROM reporting_tncpa.registration
    where patient_activeflag = 'Y'
   AND registration_date >= '2024-01-01' 
and registration_date < '2026-12-31'
    GROUP BY CAST(registration_date AS DATE)
)
SELECT
    SUM(daily_registrations) AS total_registrations,
    COUNT(*) AS days_counted,
    ROUND(AVG(daily_registrations), 1) AS avg_daily_registrations,
    ROUND(STDDEV_SAMP(daily_registrations), 1) AS stddev_daily_registrations,
    MAX(daily_registrations) AS peak_single_day
FROM DAILY;


